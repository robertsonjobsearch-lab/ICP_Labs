# Copy to .env and replace the placeholders. Never commit .env.
#   cp .env.example .env

# development | production
APP_ENV=development

# PostgreSQL (internal to Docker; never published to the host or internet)
POSTGRES_DB=icp_lead_finder
POSTGRES_USER=icp_app
# Generate one with: openssl rand -hex 24   (use letters/digits only)
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Comma-separated browser origins allowed to call the API. Requests from any
# other origin are rejected. Wildcards ("*") are not allowed.
# Default Compose publishes http://127.0.0.1:3000.
# Local demo overlay (docker-compose.demo.yml) publishes http://127.0.0.1:3012
# and http://127.0.0.1:8012. Use this value for that overlay:
# CORS_ALLOWED_ORIGINS=http://localhost:3012,http://127.0.0.1:3012
# Production example: https://leads.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sign-in. false = no sign-in: anyone who can reach the site can search,
# see and export all saved leads, and use provider credits.
# true = team members must sign in (create the first admin with app.cli).
AUTH_REQUIRED=false

# Session cookies. COOKIE_SECURE must be true in production (HTTPS only).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Contact-data provider. Leave empty in development to use the demo (mock)
# provider. The mock provider returns fictional demonstration prospects, not
# verified real leads. Must be set explicitly in production: mock or apollo.
CONTACT_PROVIDER=
# Required for CONTACT_PROVIDER=apollo. Configure secrets in the host environment.
APOLLO_API_KEY=
# Maximum estimated enrichment credits per UTC day (0 disables new reveals).
APOLLO_USER_DAILY_CREDIT_BUDGET=25
APOLLO_DAILY_CREDIT_BUDGET=100

# Rate limits (per minute)
LOGIN_RATE_LIMIT_PER_MINUTE=5
SEARCH_RATE_LIMIT_PER_MINUTE=20

# Production only (used by docker-compose.prod.yml / Caddy):
# Your domain (leads.yourcompany.com) or the server's public IP address.
# SITE_ADDRESS=
